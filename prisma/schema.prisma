generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model InviteParty {
  id             String                   @id @default(uuid())
  inviteCode     String                   @unique
  displayName    String?
  maxExtraGuests Int                      @default(0)
  guests         InvitePartyGuest[]
  extraGuests    InvitePartyExtraGuest[]
}

model InvitePartyExtraGuest {
  id          String      @id @default(uuid())
  partyId     String
  party       InviteParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  sortOrder   Int         @default(0)
  displayName String
  allergies   String?

  @@index([partyId])
}

model InvitePartyGuest {
  id          String      @id @default(uuid())
  partyId     String
  party       InviteParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  sortOrder   Int         @default(0)
  displayName String
  isAttending Boolean?
  allergies   String?

  @@index([partyId])
}

model AddressSubmission {
  id          String   @id @default(uuid())
  name        String?
  addressText String
  createdAt   DateTime @default(now())
}
